DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/portfolio"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/portfolio"

# Default behavior: when Clerk or Neon env vars are missing, the app runs with
# built-in demo auth and in-memory sample hotel data.
# This fallback is expected for local preview and intentional demo-only usage.
# Staging and production must set this to "false" and provide dedicated Clerk and Neon resources.
HOTEL_APP_DEMO_MODE="true"

# Optional hosted testing tool. Keep disabled unless a real Admin user needs to
# preview staff roles. The allow-list is comma or whitespace separated Clerk user ids.
HOTEL_APP_ROLE_PREVIEW_ENABLED="false"
HOTEL_APP_ROLE_PREVIEW_USER_IDS=""

# Optional seed helper. Set this to your Clerk user id before running bun run db:seed.
SEED_CLERK_USER_ID="user_..."
SEED_CLERK_ORGANIZATION_ID="org_..."
